# Copy to .env.local for local development, or pull from Vercel:
#   vercel env pull .env.local
#
# The game runs without any of these — it falls back to guest play with the save
# in localStorage. Set them to enable cloud saves, login and the social features.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key. Safe in the browser: every table has RLS and the
# client is never allowed to write game state directly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (service role). SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# On Vercel add it with:  vercel env add SUPABASE_SECRET_KEY --sensitive
SUPABASE_SECRET_KEY=

# Public origin used for auth redirects. Optional on Vercel (falls back to
# VERCEL_PROJECT_PRODUCTION_URL), required if you use a custom domain locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
